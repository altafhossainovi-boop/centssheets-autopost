# Copy this file to automation/.env and fill the first block.
# Never commit .env. Never paste these values in chat.

# --- You fill these (Meta app > App settings > Basic) ---
META_APP_ID=
META_APP_SECRET=
# Short-lived user token from Graph API Explorer (expires in ~1 hour).
# meta_setup.py turns it into a never-expiring Page token.
META_USER_TOKEN=

# --- meta_setup.py fills these ---
GRAPH_VERSION=v26.0
FB_PAGE_ID=
FB_PAGE_TOKEN=
IG_USER_ID=

# --- Posting schedule ---
# Day 1 of content/calendar.json is posted on this date.
REELS_START_DATE=2026-10-19
